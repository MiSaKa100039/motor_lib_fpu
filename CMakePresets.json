{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "LCA039_CLOCK_SOURCE": "RCH",
                "LCA039_SYSCLK_HZ": "72000000",
                "LCA039_OSCH_HZ": "16000000",
                "LCA039_APB0_DIV": "1",
                "LCA039_APB1_DIV": "1",
                "LCA039_VDD_MV": "3300",
                "LCA039_FIRMWARE_MODE": "NORMAL",
                "MOTOR_PLATFORM_ENABLE_VOFA": "ON"
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "RelWithDebInfo",
            "inherits": "default",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "TargetTest",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LCA039_FIRMWARE_MODE": "TEST",
                "LCA039_TARGET_TEST_CASE": "SAFE_SELF_TEST",
                "LCA039_TEST_ENABLE_DANGEROUS": "OFF",
                "MOTOR_PLATFORM_ENABLE_VOFA": "ON"
            }
        },
        {
            "name": "TargetTimAdcVofa",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LCA039_FIRMWARE_MODE": "TEST",
                "LCA039_TARGET_TEST_CASE": "TIM_ADC_VOFA",
                "LCA039_TEST_ENABLE_DANGEROUS": "OFF",
                "MOTOR_PLATFORM_ENABLE_VOFA": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "Debug", "configurePreset": "Debug" },
        { "name": "Release", "configurePreset": "Release" },
        { "name": "RelWithDebInfo", "configurePreset": "RelWithDebInfo" },
        { "name": "TargetTest", "configurePreset": "TargetTest" },
        { "name": "TargetTimAdcVofa", "configurePreset": "TargetTimAdcVofa" }
    ]
}
