/*********************************************************************
* LCM32F039 attach-only Ozone project
*
* The TargetDownload override intentionally prevents Ozone from
* programming internal Flash until a J-Link flash loader is installed.
**********************************************************************
*/

void OnProjectLoad(void) {
  Project.SetDevice("Cortex-M0");
  Project.SetHostIF("USB", "");
  Project.SetTargetIF("SWD");
  Project.SetTIFSpeed("100 kHz");
  Project.SetJLinkLogFile("$(ProjectDir)/../build/Debug/LCA039_Attach_Ozone_JLink.log");
  Project.AddSvdFile("$(ProjectDir)/LCM32F039.svd");
  File.Open("$(ProjectDir)/../build/Debug/lca039_template.elf");
}

void TargetDownload(void) {
  // Attach only. The image must already be present in target Flash.
}
