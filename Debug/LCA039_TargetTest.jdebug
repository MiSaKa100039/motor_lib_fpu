/*********************************************************************
* LCM32F039 Ozone target-test project
*
* Install the project-local J-Link device package before opening this
* project. Build the TargetTest preset before loading this file.
**********************************************************************
*/

void OnProjectLoad(void) {
  Project.SetDevice ("LCM32F039");
  Project.SetHostIF ("USB", "");
  Project.SetTargetIF ("SWD");
  Project.SetTIFSpeed ("1 MHz");
  Project.SetJLinkLogFile("$(ProjectDir)/../build/TargetTest/LCA039_TargetTest_Ozone_JLink.log");
  Project.AddSvdFile("$(ProjectDir)/LCM32F039.svd");
  File.Open("$(ProjectDir)/../build/TargetTest/lca039_template.elf");
}
