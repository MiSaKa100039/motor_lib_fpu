		<peripheral>
			<name>CRC</name>
			<groupName>COPROC</groupName>
			<baseAddress>0x48011000</baseAddress>	
			<addressBlock>
				<offset>0x0</offset>
				<size>0x1000</size>
				<usage>registers</usage>
			</addressBlock>		
			<registers>
          		<register>
					<name>CTRL</name>
					<displayName>CTRL</displayName>
					<description>Cyclic Redundancy Check Control register</description>
					<addressOffset>0x00</addressOffset>
					<size>0x20</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<fields>
						<field>
							<name>CRC_GPS</name>
							<description>CRC Polynomial selection</description>
							<bitOffset>24</bitOffset>
							<bitWidth>2</bitWidth>
						</field>
						<field>
							<name>CRC_SWAP</name>
							<description>CRC Byte order conversion of data to be checked</description>
							<bitOffset>17</bitOffset>
							<bitWidth>2</bitWidth>
						</field>
						<field>
							<name>CRC_LMS</name>
							<description>CRC Large Mall Select</description>
							<bitOffset>16</bitOffset>
							<bitWidth>1</bitWidth>
						</field>
						<field>
							<name>CRC_IVN_EN</name>
							<description>CRC Operation result byte size end selection </description>
							<bitOffset>15</bitOffset>
							<bitWidth>1</bitWidth>
						</field>
						<field>
							<name>CRC_BYTE</name>
							<description>CRC byte</description>
							<bitOffset>8</bitOffset>
							<bitWidth>2</bitWidth>
						</field>
						<field>
							<name>CRC_VALID</name>
							<description>CRC Valid result flag data</description>
							<bitOffset>2</bitOffset>
							<bitWidth>1</bitWidth>
						</field>
						<field>
							<name>CRC_SRST</name>
							<description>CRC Start Reset</description>
							<bitOffset>1</bitOffset>
							<bitWidth>1</bitWidth>
						</field>
						<field>
							<name>CRC_SRSTALL</name>
							<description>CRC Reset</description>
							<bitOffset>0</bitOffset>
							<bitWidth>1</bitWidth>
						</field>
					</fields>
				</register>
				<register>
					<name>DATA</name>
					<displayName>DATA</displayName>
					<description>Cyclic Redundancy Check Data register</description>
					<addressOffset>0x04</addressOffset>
					<size>0x20</size>
