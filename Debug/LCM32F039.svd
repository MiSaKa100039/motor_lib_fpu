					<fields>
						<field>
							<name>OE</name>
							<description>Overrun error</description>
							<bitOffset>3</bitOffset>
							<bitWidth>1</bitWidth>
						</field>
						<field>
							<name>BE</name>
							<description>Break error</description>
							<bitOffset>2</bitOffset>
							<bitWidth>1</bitWidth>
