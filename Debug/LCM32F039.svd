                <name>TIM1_NON_CC</name>
                <description>timer1 non capture compare</description>  
                <value>13</value>
            </interrupt>
            <interrupt>
                <name>TIM1_CC</name>
                <description>timer1 capture compare</description>
                <value>14</value>
            </interrupt>
